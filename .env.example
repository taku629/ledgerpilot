# --- LLM backend (optional: app runs on a deterministic engine without it) ---
# Any OpenAI-compatible chat-completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Security / policy ---
MAX_SANDBOX_ACTION_AMOUNT=50000   # Tier-2 amount cap (USD)
APPROVAL_TTL_SECONDS=300          # approval token lifetime
DEFAULT_CASH_BUFFER=30000         # low-balance alert threshold (USD)

# --- Runtime ---
PORT=8000
