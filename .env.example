# --- LLM backend (optional: app runs on a deterministic engine without it) ---
# Any OpenAI-compatible chat-completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Security / policy (LEDGERPILOT_ prefix) ---
LEDGERPILOT_MAX_ACTION_AMOUNT=50000   # Tier-2 amount cap (USD)
LEDGERPILOT_APPROVAL_TTL=300          # approval token lifetime (seconds)
LEDGERPILOT_CASH_BUFFER=30000         # low-balance alert threshold (USD)
# LEDGERPILOT_DATA_DIR=./data         # override data directory
# LEDGERPILOT_AUDIT_LOG=./data/audit_log.jsonl
# LEDGERPILOT_BUSINESS="Harbor & Bean Roasters"
# LEDGERPILOT_DATA_DATE=2026-10-18    # pin generated data to a fixed end date
#                                     # (unset = anchored to today, drifts daily)

# --- Runtime ---
PORT=8000
